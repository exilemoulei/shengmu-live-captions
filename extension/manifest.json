{
  "manifest_version": 3,
  "name": "声幕 - 实时字幕翻译",
  "short_name": "声幕",
  "version": "0.4.3",
  "minimum_chrome_version": "116",
  "description": "捕获当前标签页的英文音频，实时生成中文字幕；支持 DeepSeek/OpenAI 等翻译 API 与本地翻译服务。",
  "permissions": [
    "activeTab",
    "downloads",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "声幕 - 实时字幕翻译",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "打开声幕控制面板"
    },
    "open_caption_window": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "打开字幕与历史窗口"
    }
  }
}
